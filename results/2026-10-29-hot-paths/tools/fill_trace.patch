index 00000000..e9750647
--- /dev/null
+++ b/src/core/display/hp_fill_trace.hpp
@@ -0,0 +1,88 @@
+#pragma once
+// SCRATCH (hot-paths track): fill-volume attribution. Never committed.
+#include <array>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <cxxabi.h>
+#include <dlfcn.h>
+#include <execinfo.h>
+#include <map>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace gui_forms::hp {
+
+using Origin = std::array<void*, 14>;
+
+inline thread_local const Origin* current = nullptr;
+
+inline Origin capture() {
+    Origin origin{};
+    backtrace(origin.data(), static_cast<int>(origin.size()));
+    return origin;
+}
+
+inline std::string frame_name(void* address) {
+    Dl_info info{};
+    if (address == nullptr || dladdr(address, &info) == 0 || info.dli_sname == nullptr) return "?";
+    int status = 0;
+    char* demangled = abi::__cxa_demangle(info.dli_sname, nullptr, nullptr, &status);
+    std::string name = status == 0 && demangled != nullptr ? demangled : info.dli_sname;
+    std::free(demangled);
+    const std::size_t paren = name.find('(');
+    if (paren != std::string::npos) name.resize(paren);
+    return name;
+}
+
+struct Totals final {
+    std::map<std::pair<int, Origin>, std::array<double, 3>> by;  // opaque area, translucent area, count
+    double opaque = 0.0;
+    double translucent = 0.0;
+    double damage = 0.0;
+    ~Totals() {
+        const char* path = std::getenv("HP_FILL_OUT");
+        if (path == nullptr) return;
+        std::FILE* out = std::fopen(path, "w");
+        if (out == nullptr) return;
+        std::fprintf(out, "damage_device_px %.0f\nopaque_fill_px %.0f\ntranslucent_fill_px %.0f\n", damage, opaque,
+                     translucent);
+        static const char* const kinds[] = {"fill_rect", "fill_rounded_rect", "stroke_rect", "clear"};
+        for (const std::pair<const std::pair<int, Origin>, std::array<double, 3>>& entry : by) {
+            std::string chain;
+            int kept = 0;
+            for (void* address : entry.first.second) {
+                const std::string name = frame_name(address);
+                if (name.find("hp::") != std::string::npos || name.find("RecordingPainter::") != std::string::npos ||
+                    name == "?") {
+                    continue;
+                }
+                if (!chain.empty()) chain += " <- ";
+                chain += name;
+                if (++kept == 7) break;
+            }
+            std::fprintf(out, "ROW\t%s\t%.0f\t%.0f\t%.0f\t%s\n", kinds[entry.first.first], entry.second[0],
+                         entry.second[1], entry.second[2], chain.c_str());
+        }
+        std::fclose(out);
+    }
+};
+
+inline Totals totals;
+
+inline void add(int kind, double area, bool opaque) {
+    Origin none{};
+    const Origin& origin = current != nullptr ? *current : none;
+    std::array<double, 3>& row = totals.by[{kind, origin}];
+    if (opaque) {
+        row[0] += area;
+        totals.opaque += area;
+    } else {
+        row[1] += area;
+        totals.translucent += area;
+    }
+    row[2] += 1.0;
+}
+
+} // namespace gui_forms::hp
